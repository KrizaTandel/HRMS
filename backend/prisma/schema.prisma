// ---------------------------------------------------------------------------
// NexusHR Backend - Prisma schema (MySQL)
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  employee
  admin
}

enum AccountStatus {
  PENDING_VERIFICATION
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  INACTIVE
}

enum AttendanceStatus {
  present
  absent
  half_day
  leave
  late
}

enum LeaveType {
  paid
  sick
  unpaid
  casual
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum PayrollStatus {
  draft
  generated
  paid
}

enum NotificationTone {
  info
  success
  warning
  danger
}

enum MessageStatus {
  sent
  delivered
  read
  edited
  deleted
}

enum MessageAttachmentType {
  image
  pdf
  document
  spreadsheet
  presentation
  other
}

enum AnnouncementPriority {
  normal
  high
}

enum TicketStatus {
  open
  assigned
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum EventType {
  holiday
  training
  meeting
  social
  deadline
  other
}

enum DocumentCategory {
  profile_picture
  resume
  certificate
  offer_letter
  contract
  identification
  finance
  legal
  other
}

// ---------------------------------------------------------------------------
// Core: Roles, Users, Employees, Sessions
// ---------------------------------------------------------------------------

model UserRole {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  password           String
  firstName          String
  lastName           String
  phone              String?
  photo              String?
  role               Role          @default(employee)
  status             AccountStatus @default(PENDING_VERIFICATION)
  verificationToken  String?       @unique
  verificationExpiry DateTime?
  emailVerifiedAt    DateTime?
  approvedAt         DateTime?
  approvedBy         String?
  approvalComment    String?
  rejectionReason    String?
  resetToken         String?       @unique
  resetTokenExpiry   DateTime?
  lastLoginAt        DateTime?
  employee           Employee?
  notifications      Notification[]
  sentMessages       Message[]      @relation("MessageSender")
  receivedMessages   Message[]      @relation("MessageReceiver")
  conversationsAsA   Conversation[] @relation("ConversationParticipantA")
  conversationsAsB   Conversation[] @relation("ConversationParticipantB")
  documents          Document[]
  tickets            HelpDeskTicket[]
  events             CompanyEvent[]
  announcements      Announcement[]
  sessions           Session[]
  scheduledEmails    ScheduledEmail[]
  auditLogs          AuditLog[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  @@index([status])
  @@index([role])
}

model Employee {
  id                String      @id @default(cuid())
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String      @unique
  employeeCode      String      @unique
  department        Department? @relation(fields: [departmentId], references: [id])
  departmentId      String?
  designation       String
  joiningDate       DateTime    @default(now())
  address           String?
  city              String?
  gender            String?
  dateOfBirth       DateTime?
  bloodGroup        String?
  emergencyContact  Json?
  salary            Json?
  manager           String?
  profileCompletion Int         @default(40)
  attendance        Attendance[]
  leaves            LeaveRequest[]
  payroll           Payroll[]
  documents         Document[]
  tickets           HelpDeskTicket[]
  @@index([departmentId])
  @@index([designation])
}

model Department {
  id          String      @id @default(cuid())
  name        String      @unique
  color       String?
  head        String?
  description String?
  employees   Employee[]
}

model Session {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revoked      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  @@index([userId])
  @@index([refreshToken])
}

// ---------------------------------------------------------------------------
// Attendance / Leave / Payroll
// ---------------------------------------------------------------------------

model Attendance {
  id           String           @id @default(cuid())
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId   String
  date         DateTime
  checkIn      String?
  checkOut     String?
  status       AttendanceStatus @default(present)
  workingHours Float            @default(0)
  notes        String?
  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  reason     String
  attachment String?
  status     LeaveStatus @default(pending)
  appliedOn  DateTime    @default(now())
  reviewedBy String?
  reviewedAt DateTime?
  comments   Json?
  timeline   Json?
  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

model Payroll {
  id         String        @id @default(cuid())
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  month      String
  basic      Float         @default(0)
  allowances Float         @default(0)
  bonus      Float         @default(0)
  tax        Float         @default(0)
  deductions Float         @default(0)
  net        Float         @default(0)
  status     PayrollStatus @default(generated)
  paidAt     DateTime?
  createdBy  String?
  @@unique([employeeId, month])
  @@index([month])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Notifications / Announcements / Messages
// ---------------------------------------------------------------------------

model Notification {
  id          String           @id @default(cuid())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  title       String
  description String
  category    String?
  time        DateTime         @default(now())
  read        Boolean          @default(false)
  tone        NotificationTone @default(info)
  @@index([userId])
  @@index([read])
}

model Announcement {
  id        String               @id @default(cuid())
  title     String
  body      String
  category  String
  priority  AnnouncementPriority @default(normal)
  pinned    Boolean              @default(false)
  author    User                 @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  @@index([pinned])
  @@index([priority])
  @@index([createdAt])
}

model Conversation {
  id             String    @id @default(cuid())
  participantA   User      @relation("ConversationParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantAId String
  participantB   User      @relation("ConversationParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  participantBId String
  messages       Message[]
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  @@unique([participantAId, participantBId])
  @@index([lastMessageAt])
}

model Message {
  id             String                 @id @default(cuid())
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User                   @relation("MessageSender", fields: [senderId], references: [id])
  senderId       String
  receiver       User                   @relation("MessageReceiver", fields: [receiverId], references: [id])
  receiverId     String
  text           String?
  time           DateTime               @default(now())
  read           Boolean                @default(false)
  readAt         DateTime?
  edited         Boolean                @default(false)
  deleted        Boolean                @default(false)
  status         MessageStatus          @default(sent)
  attachmentType MessageAttachmentType?
  attachmentName String?
  attachmentSize String?
  attachmentUrl  String?
  @@index([conversationId, time])
  @@index([receiverId, read])
}

// ---------------------------------------------------------------------------
// Documents / Help Desk / Events
// ---------------------------------------------------------------------------

model Document {
  id           String           @id @default(cuid())
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId   String
  name         String
  category     DocumentCategory @default(other)
  size         String?
  type         String?
  url          String?
  verified     Boolean          @default(false)
  uploadedOn   DateTime         @default(now())
  uploadedBy   User?            @relation(fields: [uploadedById], references: [id])
  uploadedById String?
  @@index([employeeId])
}

model HelpDeskTicket {
  id          String         @id @default(cuid())
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  subject     String
  description String
  category    String?
  priority    TicketPriority @default(medium)
  status      TicketStatus   @default(open)
  assignee    User?          @relation(fields: [assigneeId], references: [id])
  assigneeId  String?
  resolution  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  @@index([status])
  @@index([employeeId])
}

model CompanyEvent {
  id          String    @id @default(cuid())
  title       String
  type        EventType @default(other)
  description String?
  startDate   DateTime
  endDate     DateTime?
  color       String?
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime  @default(now())
  @@index([startDate])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Emails (outbox + scheduled) / Audit
// ---------------------------------------------------------------------------

model EmailOutbox {
  id        String   @id @default(cuid())
  to        String
  category  String
  subject   String
  body      String?
  sentAt    DateTime @default(now())
  read      Boolean  @default(false)
  status    String   @default("sent")
  createdBy String?
}

model ScheduledEmail {
  id            String    @id @default(cuid())
  category      String
  subject       String
  body          String
  recipientType String    @default("all") // all | department | selected
  department    String?
  recipients    Json?
  sendAt        DateTime
  status        String    @default("scheduled") // scheduled | sent | cancelled
  createdBy     User?     @relation(fields: [createdById], references: [id])
  createdById   String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([status])
  @@index([sendAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  actor     String
  action    String
  detail    String?
  entity    String?
  ip        String?
  timestamp DateTime @default(now())
  @@index([actor])
  @@index([action])
  @@index([timestamp])
}
